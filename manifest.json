{
  "manifest_version": 3,
  "name": "Tasca",
  "version": "0.2.2",
  "description": "A minimal text-based task manager.",
  "action": {
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Open Tasca"
    }
  }
}
