{
  "manifest_version": 3,
  "name": "Tasca",
  "version": "0.21.2",
  "description": "A minimal text-based task manager.",
  "permissions": ["tabs", "sidePanel"],
  "action": {
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open Tasca sidebar"
    },
    "open-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Open Tasca tab"
    },
    "add-from-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+T"
      },
      "description": "Add task from current tab"
    }
  }
}
